# Neon Postgres — pooled connection string (…-pooler.…neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Shared login password for the app UI
APP_PASSWORD="change-me"

# Bearer token for POST /api/staged (external OCR pipeline)
INGEST_TOKEN="change-me-too"

# Bearer token for /api/bol/* (external shipment-tracking agent).
# Separate from INGEST_TOKEN so it can be rotated or revoked on its own.
BOL_AGENT_TOKEN="change-me-as-well"

# Optional: separate secret for signing session cookies (defaults to APP_PASSWORD)
# SESSION_SECRET=""

# Anthropic API key — חילוץ קובצי PDF שמועלים ידנית: הזמנות מ-/intake,
# חשבוניות ספק מ-/invoices וחשבוניות בלדר מ-/courier (שרת בלבד)
ANTHROPIC_API_KEY=""

# Optional: model override for all three PDF extractions (default: claude-sonnet-5)
# EXTRACT_MODEL=""

# --- מעקב משלוחים דרך API של הספקיות: לא בשימוש כרגע ---------------------
# היום קלוד נכנס לאתרי המעקב בעצמו מתוך המשימה המתוזמנת ומדווח דרך
# shipment_update, ולכן המשתנים האלה לא נדרשים כדי שהמערכת תעבוד.
# ברגע שיהיו מפתחות, poller בשרת יקרא ל-API ויכתוב לאותה פונקציה בדיוק.
# ראה docs/CONTEXT.md — "מפתחות API לספקיות" — לכל הפרטים.
# FEDEX_CLIENT_ID=""
# FEDEX_CLIENT_SECRET=""
# UPS_CLIENT_ID=""
# UPS_CLIENT_SECRET=""
# DHL_API_KEY=""
